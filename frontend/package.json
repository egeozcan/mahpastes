{
  "name": "mahpastes-frontend",
  "version": "1.0.0",
  "description": "Frontend for mahpastes clipboard manager",
  "scripts": {
    "build": "npm run build:css && npm run build:text-editor",
    "build:css": "tailwindcss -i ./src/main.css -o ./dist/output.css --minify",
    "build:text-editor": "node scripts/build-text-editor.mjs",
    "check:text-editor-bundle": "node scripts/check-text-editor-bundle.mjs",
    "dev": "tailwindcss -i ./src/main.css -o ./dist/output.css --watch"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "esbuild": "0.28.1",
    "saxes": "6.0.0",
    "smol-toml": "1.7.1",
    "tailwindcss": "^3.4.0",
    "yaml": "2.9.0"
  }
}
